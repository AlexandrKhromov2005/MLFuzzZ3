# LLVM plugin code uses upstream LLVM API patterns (factories return
# raw pointers managed by Module/Context; extern "C" plugin entry
# point; lambdas that capture into pass-builder callbacks) that don't
# align with the project's cppcoreguidelines/modernize/readability
# rules. The file is small and reviewed manually; disable repo-wide
# checks here rather than littering the code with NOLINT pragmas
# (same rationale as edge_coverage_pass/.clang-tidy).
Checks: '-*'
WarningsAsErrors: ''
